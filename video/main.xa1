# =============================================================================
# main.xa1 — video/ の入口なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# athanorw が `<サブプロジェクト名>:<タスク名>` を受け取って、ここの projectOf へ左辺を渡すのだ～🌱
# 返ってくるのは、そのサブプロジェクトのモジュールの戻り値で、タスクはその直下から名前で呼べるのだ～🌱
#
# 呼び出しの例：
#   xarpite -A 5 -q -e 'USE("/abs/video/main").projectOf("2026-04-12-sarracenia").build()'
# =============================================================================

API(5)

# LOCATION はこのファイル自身のパスだから、その親を取れば、呼び出し元の居場所に関わらず video/ が得られるのだ～🌱
INC += LOCATION RESOLVE ".." RESOLVE "src/main/xa1"

@USE("common")

{
  projectOf: projectOf
}

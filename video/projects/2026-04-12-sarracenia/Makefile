# =============================================================================
# Makefile — サラセニア寸劇動画を組み立てる入口なのだ～🌱
# -----------------------------------------------------------------------------
# 段の中身は、video/ 直下の Makefile が定義していて、ここはその場所を渡すだけなのだ～🌱
#
# 出力：
#   build/movie/2026-04-12-sarracenia/2026-04-12-sarracenia.mp4 … 完成動画
# =============================================================================

# この Makefile の置き場所（この動画プロジェクトのディレクトリ）の絶対パスなのだ～🌱
PROJECT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

include $(PROJECT)/../../Makefile

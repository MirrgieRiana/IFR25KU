# =============================================================================
# build-scene.xa1 — サラセニア寸劇に固有の、構成の材料なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# この動画のサブプロジェクトの xa1 が USE で読んで、build を scene の段へ渡すのだ～🌱
# 構成を組み上げる処理そのものは共通の skit-v1.xa1 が持って、ここはこの寸劇に固有の値だけを渡すのだ～🌱
#
# build の引数：
#   timelinePath … timeline.json のパスなのだ～🌱
#   outDir       … 生成物を書き出す先のディレクトリなのだ～🌱
#   sceneDir     … 生成物が最後に置かれるディレクトリなのだ～🌱
# =============================================================================

API(5)

# このプロジェクトのディレクトリの絶対パスなのだ～🌱
# RESOLVE は左辺をディレクトリとして扱うから、LOCATION のファイル名の分も 1 階層として数えるのだ～🌱
base := LOCATION RESOLVE ".."

skitModule := USE(base RESOLVE "../common/skit/skit-v1")

# --- 立ち絵 PSD から切り出すレイヤー ID の一覧なのだ～🌱 -------------------------
# この並びはテンプレートの PORTRAIT 定義と一致していなければならないのだ～🌱
# ID 体系は劇場の layers.json と同じで、兄弟レイヤーの 1 始まりインデックスを "-" で連結したものなのだ～🌱
# （グループもインデックスを 1 個消費するのだ～🌱）
ZUNDA_IDS := "1,4-2,8-5,8-2,8-3,7-14-3,7-14-4-9,7-6,5-8,5-2,5-1,6-6,9-2,4-4-8,4-4-3,4-4-6,4-4-5,4-3-8,4-3-3,10-3"
TSUMUGI_IDS := "2,3,4,12,13-3,13-4,9-4,9-1,9-2,9-3,8-6-2,8-6-3-6,8-4,10-14,10-8,10-10,7-2,6-3,5-5,5-1,5-3,13-2"

# 立ち絵のキャラなのだ～🌱
# name が切り出し先のディレクトリの名前で、ids がそのキャラから切り出すレイヤーなのだ～🌱
CHARACTERS := [
  {name: "zundamon"; psd: "zundamon23.psd"; ids: ZUNDA_IDS}
  {name: "tsumugi"; psd: "tsumugi3.psd"; ids: TSUMUGI_IDS}
]

# 台詞ごとのポーズ（眉・腕・汗）なのだ～🌱
# 並びは timeline.lines と対応して、値はテンプレートの pg キーなのだ～🌱
# sweat のキーを持つものだけ、汗を出すのだ～🌱
# 導入部（開幕のデカ字サムネから初回発話まで）は、サムネのキメ姿勢なのだ～🌱
POSE_DEFAULT := {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
POSES := [
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "point"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "up"; armR: "raise"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "think"}}
  {t: {brow: "angry"; armR: "mouth"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "mouth"; armL: "base"}}
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
]

{
  build: (timelinePath; outDir; sceneDir) -> skitModule.build(
    {
      base: base
      characters: CHARACTERS
      fonts: ["ZenMaruGothic-Black.ttf", "ZenMaruGothic-Bold.ttf"]
      emojis: ["seedling.svg"]

      # テンプレートが読む素材なのだ～🌱
      # TEX はテクスチャの相対パスの基準で、resourceDir は外部取得リソースの置き場所なのだ～🌱
      assetsOf: (TEX; resourceDir) -> {
      plant: TEX RESOLVE "textures/block/magic_plant/sarracenia_age3.png"
      leaf: TEX RESOLVE "textures/item/sarracenia_leaf.png"
      logo: TEX RESOLVE "icon.png"
      bg: TEX RESOLVE "textures/block/haimeviska_log.png"
      # seedling はパスではなく「生の SVG 文字列」なのだ～🌱
      # テンプレートが innerHTML に直接差し込むのだ～🌱
      seedling: READ(resourceDir RESOLVE "emoji/seedling.svg")::replace(/^\s+|\s+$/g; "")
      }

      poseDefault: POSE_DEFAULT
      poses: POSES

      # この寸劇のシーンとアイテムの不透明度なのだ～🌱
      # 沼地の背景は、泥沼のクロスフェードの下敷きだから、swampOp はずっと 1 なのだ～🌱
      framePartOf: (t; timeline; ops) -> (
        bogScenes := [timeline.scenes() >> FILTER[s => s.scene == "bog"]]
        {
          bogOp: $#bogScenes > 0 ? ops.fadeIn(t; bogScenes.0.start; timeline.sceneFade) : 0
          swampOp: 1
          plantOp: ops.itemOp(t; "plant")
          leafOp: ops.itemOp(t; "leaf")
        }
      )
    }
    timelinePath; outDir; sceneDir
  )
}

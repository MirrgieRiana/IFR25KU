# =============================================================================
# build-scene.xa1 — サラセニア寸劇の「構成」を作る処理の本体なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# このディレクトリの main.xa1 の buildScene が、INC 経由で USE で読むのだ～🌱
# タイムラインを受け取って、レンダラーに渡す材料を、ぜんぶ作るのだ～🌱
#
# 引数：
#   ARGS.0       … timeline.json のパスなのだ～🌱
#   ARGS.1       … 生成物を書き出す先のディレクトリなのだ～🌱
# 出力（書き出し先の配下）：
#   skit-v1.html … 共有のテンプレートへのシンボリックリンクで、下の 3 個と同じ場所に無いと、相対パスが外れちゃうのだ～🌱
#   assets.js    … テンプレートが読む、絵文字・テクスチャのパス・タイムラインの束
#   portrait/    … 立ち絵 PSD から切り出したレイヤー PNG
#   frames.jsonl … 1 行 = 1 フレームの構成jsonl（レンダラーへの入力）
# =============================================================================

API(5)

# このプロジェクトのディレクトリの絶対パスなのだ～🌱
# RESOLVE は第 1 引数をディレクトリとして扱うから、LOCATION のファイル名の分も 1 階層として数えるのだ～🌱
# 読み込むパスは、全部これを基準に組むから、どのディレクトリから呼んでも同じ場所を触るのだ～🌱
base := RESOLVE(LOCATION; "..")

timelinePath := ARGS.0
outDir := ARGS.1

# 構成jsonl の各行の template に入れる、この動画のテンプレートなのだ～🌱
# レンダラーは、frames.jsonl のあるディレクトリ（書き出し先）を基準に解決するのだ～🌱
template := "skit-v1.html"

# 書き出し先から共有のテンプレートへ辿る相対パスなのだ～🌱
# シンボリックリンクの行き先として渡すから、絶対パスではなく相対パスで組むのだ～🌱
# 書き出し先が projects/<名前>/build/scene だから、projects/common へは 3 階層上がるのだ～🌱
templateSource := "../../../common" RESOLVE template

# build_video.py の -framerate と一致させるのだ～🌱
FPS := 30

# --- 立ち絵 PSD から切り出すレイヤー ID の一覧なのだ～🌱 -------------------------
# この並びはテンプレートの PORTRAIT 定義と一致していなければならないのだ～🌱
# ID 体系は劇場の layers.json と同じで、兄弟レイヤーの 1 始まりインデックスを "-" で連結したものなのだ～🌱
# （グループもインデックスを 1 個消費するのだ～🌱）
ZUNDA_IDS := "1,4-2,8-5,8-2,8-3,7-14-3,7-14-4-9,7-6,5-8,5-2,5-1,6-6,9-2,4-4-8,4-4-3,4-4-6,4-4-5,4-3-8,4-3-3,10-3"
TSUMUGI_IDS := "2,3,4,12,13-3,13-4,9-4,9-1,9-2,9-3,8-6-2,8-6-3-6,8-4,10-14,10-8,10-10,7-2,6-3,5-5,5-1,5-3,13-2"

# 外部コマンドを実行して、その出力の行の配列を返して、終了コードが 0 でなければ止めるのだ～🌱
# 同梱の xarpite の EXECL は、終了コードが 0 でないと、子の標準出力も標準エラーも捨てちゃうのだ～🌱
# だから、bash に包んで、標準エラーを標準出力へ合わせて、終了コードを最後の行で受け取るのだ～🌱
# 出力が改行で終わらないときも終了コードが別の行になるように、出力の末尾の改行を 1 個にそろえてから流すのだ～🌱
capture := command -> (
  lines := [EXECL("bash", "-c", %>out=$("$@" 2>&1); code=$?; [ -n "$out" ] && printf '%s\n' "$out"; echo "$code"<%, "run", command)]
  exitCode := lines.($#lines - 1)
  output := lines[0 ~ ($#lines - 1)]
  exitCode == "0" || (
    OUT << output()
    ERR("ERROR: command failed with exit code $exitCode: $(command >> JOIN[" "])")
    EXIT(1)
  )
  output
)

run := command -> OUT << capture(command)()

# --- 外部取得リソース（このシーンの立ち絵・フォント・絵文字）の存在を確認するのだ～🌱 ---
# FILE_NAMES のストリームのままだと、@ が部分文字列で探して、隣の *.md5 のファイル名に当たっちゃうのだ～🌱
# だから、配列にしてから、要素として探すのだ～🌱
need := dir, name -> (
  name @ [FILE_NAMES(dir)] || (
    ERR("ERROR: resource not found: $dir/$name (place it as described in README.md)")
    EXIT(1)
  )
)
need(base RESOLVE "../common/resources/psd"; "zundamon23.psd")
need(base RESOLVE "../common/resources/psd"; "tsumugi3.psd")
need(base RESOLVE "../common/resources/font"; "ZenMaruGothic-Black.ttf")
need(base RESOLVE "../common/resources/font"; "ZenMaruGothic-Bold.ttf")
need(base RESOLVE "../common/resources/emoji"; "seedling.svg")

# --- 1. テンプレートと、それが読む assets.js を書き出し先へ置くのだ～🌱（絵文字・テクスチャのパス・タイムライン） ---
# レンダリングは Chromium に file://.../skit-v1.html を開かせて 1 フレームずつ撮る方式なのだ～🌱
# file:// で開いた HTML は、セキュリティ上、外部ファイルを fetch() で読めないのだ～🌱
# そこで、JS が値として要るものは 1 個のファイル（assets.js）に「焼き込んで」おいて、テンプレートから <script> で読み込むのだ～🌱
# 一方、img の src と CSS の url() は fetch() を通らないから、file:// でも相対パスのまま読めるのだ～🌱
# だから、テクスチャとフォントは、焼き込まずに、パスのまま渡すのだ～🌱
# 写すのではなく、シンボリックリンクを張るのだ～🌱
# Chromium は file:// でリンクを開いても、リンク自身の置き場所を基準に相対パスを解決するから、
# テンプレートの中の assets.js と portrait/ は、書き出し先の側を指すのだ～🌱
OUT << "== link template =="
run("ln", "-sfn", templateSource, outDir RESOLVE template)

OUT << "== bake assets.js =="

# IFR25KU リポジトリ内のテクスチャ（＝コミット済みの素材なので、リポジトリから直接読むのだ～🌱）
# このパスは、テンプレートの置き場所、つまり書き出し先を基準に解決されるのだ～🌱
TEX := "../../../../../common/src/main/resources/assets/miragefairy2024"

assets := {
  plant: TEX RESOLVE "textures/block/magic_plant/sarracenia_age3.png"
  leaf: TEX RESOLVE "textures/item/sarracenia_leaf.png"
  logo: TEX RESOLVE "icon.png"
  bg: TEX RESOLVE "textures/block/haimeviska_log.png"
  # seedling はパスではなく「生の SVG 文字列」なのだ～🌱
  # テンプレートが innerHTML に直接差し込むのだ～🌱
  seedling: READ(base RESOLVE "../common/resources/emoji/seedling.svg")::replace(/^\s+|\s+$/g; "")
}
timeline := $*READ(timelinePath)

WRITE(outDir RESOLVE "assets.js"; "window.ASSETS=$(assets >> JSON[indent: NULL]);\nwindow.TIMELINE=$(timeline >> JSON[indent: NULL]);\n")
OUT << "baked assets.js: $(assets() | _.0 >> JOIN[", "])"
OUT << "  timeline: total= $(timeline.total) lines= $($#timeline.lines)"

# --- 2. 立ち絵 PSD から必要なレイヤーを PNG に切り出すのだ～🌱（→ portrait/<char>/<id>.png） -----
OUT << "== extract portrait =="
# 切り出しのツールは、レンダラーと同じく video/ 直下の兄弟で、Node 依存も自分で面倒を見るのだ～🌱
extractPortrait := base RESOLVE "../../extract-portrait/extract-portrait.sh"
psdDir := base RESOLVE "../common/resources/psd"
run("bash", extractPortrait, "zundamon", psdDir RESOLVE "zundamon23.psd", ZUNDA_IDS, outDir RESOLVE "portrait/zundamon")
run("bash", extractPortrait, "tsumugi", psdDir RESOLVE "tsumugi3.psd", TSUMUGI_IDS, outDir RESOLVE "portrait/tsumugi")

# --- 3. 構成jsonl を組み立てるのだ～🌱（→ frames.jsonl） -------------------------
# 各行は、そのフレームの見た目を決めるパラメータなのだ～🌱
# 背景とアイテム枠の不透明度は、ここで計算して渡すのだ～🌱
# 台詞ごとのポーズと、字幕の中身も、ここで決めて渡すのだ～🌱
# 残るのは、開幕のデカ字のフィットだけで、それは時刻に依らないのだ～🌱
OUT << "== compose frames.jsonl =="
total := timeline.total
frameCount := -FLOOR(-(total * FPS))

# テンプレートの clamp・fadeIn と、式も演算の順序もそろえてあるのだ～🌱
# JS も xarpite も IEEE 754 の倍精度だから、そろえておけば、同じ時刻に同じ値が出るのだ～🌱
clamp := (x; a; b) -> MAX(a; MIN(b; x))
fadeIn := (t; start; dur) -> clamp((t - start) / dur; 0; 1)
fadeOut := (t; start; dur) -> 1 - clamp((t - start) / dur; 0; 1)

bogScenes := [timeline.scenes() >> FILTER[s => s.scene == "bog"]]
bogOp := t -> $#bogScenes > 0 ? fadeIn(t; bogScenes.0.start; timeline.sceneFade) : 0
itemOp := (t; name) -> (
  ops := [timeline.items() >> FILTER[it => it.item == name] | it => clamp(MIN((t - it.start) / 0.22; (it.end + 0.18 - t) / 0.22); 0; 1)]
  $#ops > 0 ? MAX(ops()) : 0
)

# 開幕のサムネは、タイトル保持のあいだ出して、タイトル明けにフェードアウトするのだ～🌱
openOp := t -> t < timeline.titleFadeStart ? 1 : fadeOut(t; timeline.titleFadeStart; timeline.titleEnd - timeline.titleFadeStart)
creditOp := t -> fadeIn(t; timeline.creditStart - 0.35; 0.5)
# クレジットが出るあいだ、立ち絵と帯と字幕を閉じるゲートなのだ～🌱
creditGate := t -> 1 - clamp(creditOp(t) * 3; 0; 1)
# その時刻に字幕を出している台詞なのだ～🌱 テンプレートと同じく、最初に当たったものを採るのだ～🌱
activeLines := t -> [timeline.lines() >> FILTER[ln => t >= ln.start && t < ln.subEnd]]
subOp := t -> (
  lns := activeLines(t)
  op := $#lns > 0 ? clamp(MIN((t - lns.0.start) / 0.12; (lns.0.subEnd + 0.05 - t) / 0.15); 0; 1) : 0
  (openOp(t) > 0.5 ? 0 : op) * creditGate(t)
)

# 台詞ごとのポーズ（眉・腕・汗）なのだ～🌱
# 並びは timeline.lines と対応して、値はテンプレートの pg キーなのだ～🌱
# sweat のキーを持つものだけ、汗を出すのだ～🌱
# 導入部（開幕のデカ字サムネから初回発話まで）は、サムネのキメ姿勢なのだ～🌱
POSE_DEFAULT := {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
POSES := [
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "point"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "up"; armR: "raise"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "think"}}
  {t: {brow: "angry"; armR: "mouth"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "mouth"; armL: "base"}}
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
]
# ポーズは「その時点で始まっている最後の台詞」で決めて、台詞の合間もそのまま保つのだ～🌱
poseAt := t -> (
  hits := [0 ~ $#timeline.lines >> FILTER[k => t >= timeline.lines.(k).start]]
  $#hits > 0 ? POSES.(hits(-1)) : POSE_DEFAULT
)

# その時刻に字幕を出している台詞の中身なのだ～🌱
# テンプレートの setSub は、i と sub と big と speaker だけを見るのだ～🌱
# 出す台詞が無いときは NULL で、JS 側の「字幕を消す」の分岐へ落ちるのだ～🌱
subLineAt := t -> (
  lns := activeLines(t)
  $#lns > 0 ? {i: lns.0.i; sub: lns.0.sub; big: lns.0.big; speaker: lns.0.speaker} : NULL
)

# 母音から口の開きを決めるのだ～🌱
# 縦の開きで 3 段で、N や pau や っ といった無声と休止は閉口なのだ～🌱
vowelMouth := v -> v == "a" ? "open" : (v == "i" || v == "u" || v == "e" || v == "o" ? "half" : "closed")
# モーラの区間を順に見て、最初に当たったものを採るのだ～🌱
# モーラの秒は wav の先頭からだから、start を引くのだ～🌱
mouthAt := (line; t) -> (
  tl := t - line.start
  hits := [line.moras() >> FILTER[m => tl >= m.0 && tl < m.2]]
  $#hits > 0 ? (tl < hits.0.1 ? "closed" : vowelMouth(hits.0.3)) : "closed"
)
# まばたきなのだ～🌱
# 閉眼は一瞬で、半目は介さずに閉と開を行き来するのだ～🌱
# 位相は、最初のフレームで両者とも目を開けているように選んであるのだ～🌱
blinkAt := (t; period; phase; dur) -> (((t + phase) % period) + period) % period < dur
# 口パクする台詞なのだ～🌱
# 字幕は音声より長く残るから、字幕の区間ではなく実発話区間で切るのだ～🌱
speakingLine := t -> (
  lns := activeLines(t)
  $#lns > 0 && t < lns.0.end ? lns.0 : NULL
)

# 沼地の背景は、泥沼のクロスフェードの下敷きだから、swampOp はずっと 1 なのだ～🌱
WRITE[outDir RESOLVE "frames.jsonl"] << 0 ~ frameCount | i => (
  t := i / FPS
  so := subOp(t)
  sp := speakingLine(t)
  spk := sp == NULL ? NULL : (sp.speaker == "ずんだもん" ? "z" : "t")
  {
    template: template; t: t
    bogOp: bogOp(t); swampOp: 1; plantOp: itemOp(t; "plant"); leafOp: itemOp(t; "leaf")
    openOp: openOp(t); creditOp: creditOp(t); portraitOp: creditGate(t); bandOp: (1 - openOp(t)) * creditGate(t)
    subOp: so; scrimOp: so * 0.85
    zMouth: spk == "z" ? mouthAt(sp; t) : "closed"; tMouth: spk == "t" ? mouthAt(sp; t) : "closed"
    zBlink: blinkAt(t; 3.4; 1.5; 0.12); tBlink: blinkAt(t; 4.1; 1.7; 0.12)
    tPose: poseAt(t).t; zPose: poseAt(t).z
    subLine: subLineAt(t)
  }
) >> JSONL >> LINESD
OUT << "composed frames.jsonl: $frameCount frames (total=$(total)s @ $(FPS)fps)"

OUT << "== scene ready: $template, assets.js, portrait/, frames.jsonl =="

# =============================================================================
# main.xa1 — この動画プロジェクトの入口なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# Makefile や、雑多パートの xa1 は、ここが返すオブジェクトの関数を呼ぶのだ～🌱
# 処理の本体は、同じディレクトリの build_scene.xa1 にあるのだ～🌱
#
# 引数：
#   ARGS.0 … timeline.json のパス（省略時は video/timeline.json）なのだ～🌱
#
# 呼び出しの例：
#   xarpite -A 5 -q -e 'USE("/abs/video/projects/2026-04-12-sarracenia/main").buildScene()' /abs/video/timeline.json
# =============================================================================

API(5)

# LOCATION はこのファイル自身のパスだから、その親を取れば、呼び出し元の居場所に関わらずこのディレクトリが得られるのだ～🌱
INC += RESOLVE(LOCATION; "..")

{
  buildScene: () -> USE("build_scene")
}

# =============================================================================
# main.xa1 — この動画プロジェクトの入口なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# この動画の Makefile は、ここが返すプロジェクトの run へ、タスクの名前を渡すのだ～🌱
# 段の中身と、段と段の順序は、video/ 直下の雑多パートの video-plugin が持つのだ～🌱
# シーンを組む処理だけは、この動画に固有だから、同じディレクトリの build-scene.xa1 にあるのだ～🌱
#
# 呼び出しの例：
#   xarpite -A 5 -q -e 'USE("/abs/video/projects/2026-04-12-sarracenia/main")::run("generateMovie")'
# =============================================================================

API(5)

# LOCATION はこのファイル自身のパスだから、その親を取れば、呼び出し元の居場所に関わらずこのディレクトリが得られるのだ～🌱
INC += LOCATION RESOLVE ".."
INC += LOCATION RESOLVE "../../.." RESOLVE "src/main/xa1"

@USE("video-plugin")

videoProjectOf(LOCATION RESOLVE "..")::ALSO ( project =>
  # 雑多パートの scene の段が、別の xarpite の呼び出しとして叩く入口なのだ～🌱
  # 引数は、timeline.json のパスと、生成物を書き出す先のディレクトリなのだ～🌱
  project.buildScene = () -> USE("build-scene")
)

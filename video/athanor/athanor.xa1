/*
 * athanor.xa1 — タスクを並べてビルドを組むための、小さなビルドシステムなのだ～🌱（xarpite / API5）
 *
 * 使う側は、プロジェクトを 1 個作って、その tasks へタスクを並べるのだ～🌱
 * タスクは、自分より前に済んでいなければならないタスクを dependsOn に持つのだ～🌱
 * タスクを走らせると、dependsOn を先にたどってから、自分の action を呼ぶのだ～🌱
 *
 *   @USE("athanor")
 *
 *   project := AthanorProject::NEW()
 *   project.tasks.generateFoo = AthanorTask::NEW()::ALSO ( task =>
 *     task.name = "foo"
 *     task.action = () -> ...
 *   )
 *   project.tasks.generateBar = AthanorTask::NEW()::ALSO ( task =>
 *     task.name = "bar"
 *     task.dependsOn = [project.tasks.generateFoo]
 *     task.action = () -> ...
 *   )
 *
 * タスクやプロジェクトを拡張したいときは、継承して `<>` を上書きするのだ～🌱
 *
 *   GenerateFooTask := AthanorTask {
 *     `<>`: this -> :
 *       AthanorTask.`<>`(this)
 *       this.name = "foo"
 *   }
 **/

API(5)

{
  /** 原因を伝えて、終了コード 1 で終わるのだ～🌱 */
  fail := message -> (
    ERR << "ERROR: $message"
    EXIT(1)
  )

  # 列挙型が無いから、列挙定数の実体は数値なのだ～🌱
  idleState := 0
  runningState := 1
  doneState := 2

  AthanorTask := {
    `<>`: this -> :
      this.name = NULL
      this.dependsOn = []
      this.action = NULL
      this._state = idleState

    /**
     * 同じタスクが複数のタスクから依存されていても、action は 1 回しか走らないのだ～🌱
     * そうしないと、共通の依存が何度も呼ばれて、無駄に走ってしまうのだ～🌱
     *
     * 実行中の状態を持つことで、依存の辺が循環していても、無限に潜る代わりに原因を伝えて終われるのだ～🌱
     */
    run: this -> :
      : this._state == idleState ? :
        this._state = runningState
        this.dependsOn() | task => task::run()
        # action がストリームを返す場合、ここで解決しないと、呼び出し元の文脈によっては副作用が起こらないのだ～🌱
        this.action == NULL ? NULL : VOID(this.action())
        this._state = doneState
      : this._state == runningState ? :
        fail << "circular dependency: $(this.name)"
      : this._state == doneState ? :
        NULL
      : :
        !! "unknown task state: $(this._state)"
  }

  AthanorProject := {
    `<>`: this -> :
      this.tasks = {}

      # どのプロジェクトにも、並んでいるタスクを見る手段を持たせるのだ～🌱
      # ここで足しておかないと、タスクを 1 個も並べていないプロジェクトでは、athanorw から叩ける名前が 1 個も無くなるのだ～🌱
      this.tasks.tasks = AthanorTask::NEW()::ALSO ( task =>
        task.name = "tasks"
        task.action = () -> this.tasks() | entry => OUT << entry.0
      )
  }

  /**
   * athanorw から呼ばれる入口なのだ～🌱
   * baseDirectory はビルドの定義が置かれているディレクトリの絶対パスで、叩く対象の名前は ARGS から順に取るのだ～🌱
   * 対象の名前は `<プロジェクト名>:<タスク名><引数スクリプト>` の形で、プロジェクト名も引数スクリプトも省略できるのだ～🌱
   * 対象を 1 個も渡されなければ、ビルドの定義を読むところまでで終わるのだ～🌱
   */
  main := baseDirectory -> (
    build := USE(baseDirectory / "build.athanor.xa1")

    # 対象ごとにプロジェクトを作り直すと、タスクの状態が引き継がれず、共通の依存が何度も走ってしまうのだ～🌱
    projects := {}
    projectOf := projectName -> projects.(projectName) ?: (
      projects.(projectName) = build.projectOf(projectName) ?: fail("project not found: $projectName")
    )

    VOID(ARGS() | target => (
      parseResult := target =~ /^(?:([^:]*):)?([^:(]+)(\(.*\))?$/ ?: fail("invalid target: $target")
      # プロジェクト名を省略すると、ルートプロジェクトのタスクになるのだ～🌱
      projectName := parseResult.1 ?: ""
      taskName := parseResult.2
      # 引数スクリプトを省略すると、引数の無い呼び出しになるのだ～🌱
      argumentScript := parseResult.3 ?: "()"

      task := projectOf(projectName).tasks.(taskName) ?: fail("task not found: $taskName")

      # 引数スクリプトはソースコードの断片だから、タスクを受け取る関数の本体として構築して評価するのだ～🌱
      XA("task -> task::run$argumentScript")(task)
    ))
  )
}

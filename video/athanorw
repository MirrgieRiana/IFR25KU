#!/bin/bash
# =============================================================================
# athanorw — video/ のタスクを走らせる入口なのだ～🌱
# -----------------------------------------------------------------------------
# 使い方なのだ～🌱：
#   ./athanorw 2026-04-12-sarracenia:build          … その動画の主要なものをビルドするのだ～🌱
#   ./athanorw 2026-04-12-sarracenia:clean          … その動画の生成物をまとめて捨てるのだ～🌱
#   ./athanorw 2026-04-12-sarracenia:generateScene  … 段を 1 個だけ叩くのだ～🌱 前の段は自分で呼ばれるのだ～🌱
#   ./athanorw '2026-04-12-sarracenia:generateMovie()' 0.3  … 2 個目からの引数は、そのまま xarpite の ARGS へ渡るのだ～🌱
#
# タスクの名前は `:` で区切るのだ～🌱 左辺がサブプロジェクト名で、右辺がタスク名なのだ～🌱
# 叩ける右辺は、そのサブプロジェクトのモジュールが返すものの直下にあるものなのだ～🌱
# サブプロジェクトは src/projects/xa1/ の下に、名前を冠した 1 個の xa1 として並ぶのだ～🌱
#
# 前提（先に済ませておくのだ～🌱 詳しくは video/README.md を読むのだ～🌱）：
#   1. 外部取得リソースを projects/common/resources/ 以下の所定パスに置くのだ～🌱（*.md5 がその置き場所と中身を示すのだ～🌱）
#   2. VOICEVOX ENGINE を起動しておくのだ～🌱（既定は http://127.0.0.1:50021）
#   3. Node.js / ffmpeg / curl を使える状態にしておくのだ～🌱
#
# 差し替え可能な設定は、環境変数のまま xa1 と render.sh へ渡るのだ～🌱
#   FFMPEG / VOICEVOX_HOST / CHROMIUM_PATH / CHROMIUM_LD_PATH
# =============================================================================
set -eu

# このスクリプトの置き場所なのだ～🌱
# どのディレクトリから呼んでも、同じ main.xa1 と xarpite を指すのだ～🌱
here=$(cd "$(dirname "$0")" && pwd)

if [ $# -eq 0 ]; then
  echo "ERROR: task name required (e.g. 2026-04-12-sarracenia:build)" >&2
  exit 1
fi

target=$1
shift

# `:` の左辺がサブプロジェクト名で、右辺がタスク名なのだ～🌱
case "$target" in
  *:*) ;;
  *)
    echo "ERROR: task name must be <subproject>:<task> (e.g. 2026-04-12-sarracenia:build)" >&2
    exit 1
    ;;
esac
subproject=${target%%:*}
task=${target#*:}

# 括弧が無いときは、引数の無い呼び出しとして補うのだ～🌱
case "$task" in
  *'('*) call=$task ;;
  *) call="$task()" ;;
esac

"$here/../xarpite/xarpite" -A 5 -q -f - "$@" <<EOF
API(5)
INC += "$here/athanor"
USE("$here/build.athanor").projectOf("$subproject").$call
EOF

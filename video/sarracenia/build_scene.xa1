# =============================================================================
# build_scene.xa1 — サラセニア寸劇の「構成」を作る処理の本体なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# build_scene.sh が、このディレクトリ（sarracenia/）へ cd してから呼ぶのだ～🌱
# タイムラインを受け取って、レンダラーに渡す材料を、ぜんぶ作るのだ～🌱
#
# 引数：
#   ARGS.0       … timeline.json のパス（省略時は ../timeline.json）なのだ～🌱
# 出力（このディレクトリ配下）：
#   assets.js    … scene.html が読む、フォント・絵文字・テクスチャ・タイムラインの束
#   portrait/    … 立ち絵 PSD から切り出したレイヤー PNG
#   frames.jsonl … 1 行 = 1 フレームの構成jsonl（レンダラーへの入力）
# =============================================================================

API(5)

timelinePath := ARGS.0 ?: "../timeline.json"

# 構成jsonl の各行の template に入れる、この動画のテンプレートなのだ～🌱
# レンダラーは、frames.jsonl のあるディレクトリ（ここ）を基準に解決するのだ～🌱
template := "scene.html"

# build_video.py の -framerate と一致させるのだ～🌱
FPS := 30

# --- 立ち絵 PSD から切り出すレイヤー ID の一覧なのだ～🌱 -------------------------
# この並びは scene.html の PORTRAIT 定義と一致していなければならないのだ～🌱
# ID 体系は劇場の layers.json と同じで、兄弟レイヤーの 1 始まりインデックスを "-" で連結したものなのだ～🌱
# （グループもインデックスを 1 個消費するのだ～🌱）
ZUNDA_IDS := "1,4-2,8-5,8-2,8-3,7-14-3,7-14-4-9,7-6,5-8,5-2,5-1,6-6,9-2,4-4-8,4-4-3,4-4-6,4-4-5,4-3-8,4-3-3,10-3"
TSUMUGI_IDS := "2,3,4,12,13-3,13-4,9-4,9-1,9-2,9-3,8-6-2,8-6-3-6,8-4,10-14,10-8,10-10,7-2,6-3,5-5,5-1,5-3,13-2"

# 外部コマンドを実行して、その出力の行の配列を返して、終了コードが 0 でなければ止めるのだ～🌱
# 同梱の xarpite の EXECL は、終了コードが 0 でないと、子の標準出力も標準エラーも捨てちゃうのだ～🌱
# だから、bash に包んで、標準エラーを標準出力へ合わせて、終了コードを最後の行で受け取るのだ～🌱
# 出力が改行で終わらないときも終了コードが別の行になるように、出力の末尾の改行を 1 個にそろえてから流すのだ～🌱
capture := command -> (
  lines := [EXECL("bash", "-c", %>out=$("$@" 2>&1); code=$?; [ -n "$out" ] && printf '%s\n' "$out"; echo "$code"<%, "run", command)]
  exitCode := lines.($#lines - 1)
  output := lines[0 ~ ($#lines - 1)]
  exitCode == "0" || (
    OUT << output()
    ERR("ERROR: command failed with exit code $exitCode: $(command >> JOIN[" "])")
    EXIT(1)
  )
  output
)

run := command -> OUT << capture(command)()

# --- 外部取得リソース（このシーンの立ち絵・フォント・絵文字）の存在を確認するのだ～🌱 ---
# FILE_NAMES のストリームのままだと、@ が部分文字列で探して、隣の *.md5 のファイル名に当たっちゃうのだ～🌱
# だから、配列にしてから、要素として探すのだ～🌱
need := dir, name -> (
  name @ [FILE_NAMES(dir)] || (
    ERR("ERROR: resource not found: $dir/$name (place it as described in README.md)")
    EXIT(1)
  )
)
need("resources/psd"; "zundamon23.psd")
need("resources/psd"; "tsumugi3.psd")
need("resources/font"; "ZenMaruGothic-Black.ttf")
need("resources/font"; "ZenMaruGothic-Bold.ttf")
need("resources/emoji"; "seedling.svg")

# --- Node 依存（ag-psd / pngjs）をそろえるのだ～🌱 ------------------------------
"node_modules" @ [FILE_NAMES(".")] || (
  OUT << "== npm install (sarracenia) =="
  run("npm", "install")
)

# --- 1. scene.html が読む assets.js を焼くのだ～🌱（フォント・絵文字・テクスチャ・タイムライン） ---
# レンダリングは Chromium に file://.../scene.html を開かせて 1 フレームずつ撮る方式なのだ～🌱
# file:// で開いた HTML は、セキュリティ上、外部ファイルを fetch() で読めないのだ～🌱
# そこで、ぜんぶ 1 個の JS ファイル（assets.js）に「焼き込んで」おいて、scene.html から <script> で読み込むのだ～🌱
OUT << "== bake assets.js =="

# IFR25KU リポジトリ内のテクスチャ（＝コミット済みの素材なので、リポジトリから直接読むのだ～🌱）
TEX := "../../common/src/main/resources/assets/miragefairy2024"

# ファイルを base64 の data-URL にするのだ～🌱
# 同梱の xarpite の BASE64 は、文字列を UTF-8 にしてから符号化するから、バイナリのファイルには使えないのだ～🌱
# だから、外の base64 コマンドで符号化して、76 文字ごとの改行をつなぎ直すのだ～🌱
dataUrl := mime, path -> "data:$mime;base64,$(capture("base64", path)() >> JOIN[""])"

assets := {
  plant: dataUrl("image/png"; "$TEX/textures/block/magic_plant/sarracenia_age3.png")
  leaf: dataUrl("image/png"; "$TEX/textures/item/sarracenia_leaf.png")
  logo: dataUrl("image/png"; "$TEX/icon.png")
  bg: dataUrl("image/png"; "$TEX/textures/block/haimeviska_log.png")
  # seedling は data-URL ではなく「生の SVG 文字列」なのだ～🌱scene.html が innerHTML に直接差し込むのだ～🌱
  seedling: READ("resources/emoji/seedling.svg")::replace(/^\s+|\s+$/g; "")
  fontBlack: dataUrl("font/ttf"; "resources/font/ZenMaruGothic-Black.ttf")
  fontBold: dataUrl("font/ttf"; "resources/font/ZenMaruGothic-Bold.ttf")
}
timeline := $*READ(timelinePath)

WRITE("assets.js"; "window.ASSETS=$(assets >> JSON[indent: NULL]);\nwindow.TIMELINE=$(timeline >> JSON[indent: NULL]);\n")
OUT << "baked assets.js: $(assets() | _.0 >> JOIN[", "])"
OUT << "  timeline: total= $(timeline.total) lines= $($#timeline.lines)"

# --- 2. 立ち絵 PSD から必要なレイヤーを PNG に切り出すのだ～🌱（→ portrait/<char>/<id>.png） -----
OUT << "== extract portrait =="
run("node", "extract_portrait.js", "zundamon", "resources/psd/zundamon23.psd", ZUNDA_IDS, "portrait/zundamon")
run("node", "extract_portrait.js", "tsumugi", "resources/psd/tsumugi3.psd", TSUMUGI_IDS, "portrait/tsumugi")

# --- 3. 構成jsonl を組み立てるのだ～🌱（→ frames.jsonl） -------------------------
# 各行は、そのフレームの見た目を決めるパラメータなのだ～🌱
# 背景とアイテム枠の不透明度は、ここで計算して渡すのだ～🌱
# 残りの要素は、まだ scene.html の seek(t) がタイムラインを見て組み立てるから、時刻 t も渡すのだ～🌱
OUT << "== compose frames.jsonl =="
total := timeline.total
frameCount := -FLOOR(-(total * FPS))

# scene.html の clamp・fadeIn と、式も演算の順序もそろえてあるのだ～🌱
# JS も xarpite も IEEE 754 の倍精度だから、そろえておけば、同じ時刻に同じ値が出るのだ～🌱
clamp := (x; a; b) -> MAX(a; MIN(b; x))
fadeIn := (t; start; dur) -> clamp((t - start) / dur; 0; 1)
fadeOut := (t; start; dur) -> 1 - clamp((t - start) / dur; 0; 1)

bogScenes := [timeline.scenes() >> FILTER[s => s.scene == "bog"]]
bogOp := t -> $#bogScenes > 0 ? fadeIn(t; bogScenes.0.start; timeline.sceneFade) : 0
itemOp := (t; name) -> (
  ops := [timeline.items() >> FILTER[it => it.item == name] | it => clamp(MIN((t - it.start) / 0.22; (it.end + 0.18 - t) / 0.22); 0; 1)]
  $#ops > 0 ? MAX(ops()) : 0
)

# 開幕のサムネは、タイトル保持のあいだ出して、タイトル明けにフェードアウトするのだ～🌱
openOp := t -> t < timeline.titleFadeStart ? 1 : fadeOut(t; timeline.titleFadeStart; timeline.titleEnd - timeline.titleFadeStart)
creditOp := t -> fadeIn(t; timeline.creditStart - 0.35; 0.5)
# クレジットが出るあいだ、立ち絵と帯と字幕を閉じるゲートなのだ～🌱
creditGate := t -> 1 - clamp(creditOp(t) * 3; 0; 1)
# その時刻に字幕を出している台詞なのだ～🌱 scene.html と同じく、最初に当たったものを採るのだ～🌱
activeLines := t -> [timeline.lines() >> FILTER[ln => t >= ln.start && t < ln.subEnd]]
subOp := t -> (
  lns := activeLines(t)
  op := $#lns > 0 ? clamp(MIN((t - lns.0.start) / 0.12; (lns.0.subEnd + 0.05 - t) / 0.15); 0; 1) : 0
  (openOp(t) > 0.5 ? 0 : op) * creditGate(t)
)

# 沼地の背景は、泥沼のクロスフェードの下敷きだから、swampOp はずっと 1 なのだ～🌱
WRITE["frames.jsonl"] << 0 ~ frameCount | i => (
  t := i / FPS
  so := subOp(t)
  {
    template: template; t: t
    bogOp: bogOp(t); swampOp: 1; plantOp: itemOp(t; "plant"); leafOp: itemOp(t; "leaf")
    openOp: openOp(t); creditOp: creditOp(t); portraitOp: creditGate(t); bandOp: (1 - openOp(t)) * creditGate(t)
    subOp: so; scrimOp: so * 0.85
  }
) >> JSONL >> LINESD
OUT << "composed frames.jsonl: $frameCount frames (total=$(total)s @ $(FPS)fps)"

OUT << "== scene ready: assets.js, portrait/, frames.jsonl =="

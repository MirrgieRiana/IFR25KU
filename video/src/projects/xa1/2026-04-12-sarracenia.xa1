# =============================================================================
# 2026-04-12-sarracenia.xa1 — サラセニア寸劇の台本とビルドの定義なのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# 1 個の動画は、台本と、その動画に固有のビルドの定義だけで決まるのだ～🌱
# だから、その 2 個を、動画の名前を冠したこの 1 個のファイルへ同居させるのだ～🌱
# video/ 直下の athanorw が、video/main.xa1 を通してこのモジュールを読んで、返ってきたもののタスクを呼ぶのだ～🌱
#
# 段の中身と、段と段の順序は、video/src/main/xa1/video-plugin.xa1 が持つのだ～🌱
# 構成を組み上げる処理は、寸劇という形式に共通だから、video/projects/common/skit/skit-v1.xa1 が持つのだ～🌱
# ここが渡すのは、この寸劇に固有の値だけなのだ～🌱
#
# 台本の 1 行ぶんの項目なのだ～🌱：
#   speaker … 話者の名前なのだ～🌱
#   sid     … VOICEVOX の話者 ID なのだ～🌱
#   speed   … 読み上げの速さの倍率なのだ～🌱
#   kana    … VOICEVOX へ渡すカナ原稿なのだ～🌱アポストロフィがアクセント核で、スラッシュが区切りなのだ～🌱
#   text    … 口パクの形を決める文字なのだ～🌱
#   sub     … 画面に出す字幕で、縦棒が改行なのだ～🌱
#   big     … 字幕を大きく出すかなのだ～🌱
#   scene   … 背景の切り替えなのだ～🌱
#   item    … 画面に出す登場アイテムなのだ～🌱
# =============================================================================

API(5)

# LOCATION はこのファイル自身のパスだから、4 階層さかのぼれば、呼び出し元の居場所に関わらず video/ が得られるのだ～🌱
videoBase := LOCATION RESOLVE "../../../.."

INC += videoBase RESOLVE "src/main/xa1"

@USE("video-plugin")

skitModule := USE(videoBase RESOLVE "projects/common/skit/skit-v1")

# この動画の名前なのだ～🌱
# main.xa1 が名前からこのファイルを読むから、名前はこのファイル自身のファイル名そのものなのだ～🌱
name := LOCATION::replace(/^.*\//; "")::replace(/\.xa1$/; "")

# --- 立ち絵 PSD から切り出すレイヤー ID の一覧なのだ～🌱 -------------------------
# この並びはテンプレートの PORTRAIT 定義と一致していなければならないのだ～🌱
# ID 体系は劇場の layers.json と同じで、兄弟レイヤーの 1 始まりインデックスを "-" で連結したものなのだ～🌱
# （グループもインデックスを 1 個消費するのだ～🌱）
ZUNDA_IDS := "1,4-2,8-5,8-2,8-3,7-14-3,7-14-4-9,7-6,5-8,5-2,5-1,6-6,9-2,4-4-8,4-4-3,4-4-6,4-4-5,4-3-8,4-3-3,10-3"
TSUMUGI_IDS := "2,3,4,12,13-3,13-4,9-4,9-1,9-2,9-3,8-6-2,8-6-3-6,8-4,10-14,10-8,10-10,7-2,6-3,5-5,5-1,5-3,13-2"

# 立ち絵のキャラなのだ～🌱
# name が切り出し先のディレクトリの名前で、ids がそのキャラから切り出すレイヤーなのだ～🌱
CHARACTERS := [
  {name: "zundamon"; psd: "zundamon23.psd"; ids: ZUNDA_IDS}
  {name: "tsumugi"; psd: "tsumugi3.psd"; ids: TSUMUGI_IDS}
]

# 台詞ごとのポーズ（眉・腕・汗）なのだ～🌱
# 並びは timeline.lines と対応して、値はテンプレートの pg キーなのだ～🌱
# sweat のキーを持つものだけ、汗を出すのだ～🌱
# 導入部（開幕のデカ字サムネから初回発話まで）は、サムネのキメ姿勢なのだ～🌱
POSE_DEFAULT := {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
POSES := [
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "point"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "mouth"; armL: "base"}; z: {brow: "up"; armR: "raise"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "think"}}
  {t: {brow: "angry"; armR: "mouth"; armL: "base"; sweat: 1}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "sad"; armR: "base"; armL: "base"}; z: {brow: "normal"; armR: "mouth"; armL: "base"}}
  {t: {brow: "cheer"; armR: "mouth"; armL: "base"}; z: {brow: "normal"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
  {t: {brow: "cheer"; armR: "point"; armL: "base"}; z: {brow: "sad"; armR: "base"; armL: "base"}}
]

# 台本なのだ～🌱
# このファイルの中でだけ使うから、モジュールの外へ出さないのだ～🌱
script := {
  title: "あまい罠は、沼で咲く"
  subtitle: "ずんだもん と 春日部つむぎ"
  lines: [
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.06
      kana: "ネ'エセンパイ、コノヌマ'、ナ'ンダカ/アマズッパ'イ/ニオ'イガ/スル'ノ"
      text: "あ"
      sub: "ねえセンパイ、この沼、｜なんだか甘ずっぱい匂いがするの。"
      big: FALSE
      scene: "swamp"
      item: ""
    }
    {
      speaker: "ずんだもん"
      sid: 3
      speed: 1.04
      kana: "ニオ'イノ/モトワ'、アレナ'ノダ、ヌマチニハエ'ル、ヘイシソオ'、サラセ'ニア"
      text: "あ"
      sub: "においのもとは、あれなのだ。｜沼地に生える、瓶子草サラセニア。"
      big: FALSE
      scene: "swamp"
      item: "plant"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.05
      kana: "ワ'ッ、ヘ'ンナ/カタチ'、ツボミノオ'クニ、トロ'ットシタ/エ'キガ/タマッテル'"
      text: "あ"
      sub: "わっ、へんな形〜！｜つぼみのおくに、とろっとした液がたまってる。"
      big: FALSE
      scene: "swamp"
      item: "leaf"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.0
      kana: "コノ'/アマイ'/ニオ'イ、ココカラ'ダ、チョットダケ'、ナ'メテ/ミタ'イ"
      text: "あ"
      sub: "この甘い匂い、ここからだ。｜ちょっとだけ、なめてみたい……。"
      big: FALSE
      scene: "swamp"
      item: "leaf"
    }
    {
      speaker: "ずんだもん"
      sid: 3
      speed: 1.03
      kana: "ヤメテオク'ノダ、ソノアマイニオ'イワ、エモノオオビキヨセ'ル/ワ'ナ/ナ'ノダ"
      text: "あ"
      sub: "やめておくのだ。｜その甘い匂いは、獲物をおびき寄せる罠なのだ。"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.02
      kana: "エ'、ワ'ナッテ？"
      text: "あ"
      sub: "え、わなって……？"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "ずんだもん"
      sid: 3
      speed: 1.04
      kana: "サラセ'ニアワ/ショクチュウショク'ブツ、アマサデ'/ムシオ'/ヨセテ'、サ'ンデ/マルゴト'/トカ'ス/ノダ'"
      text: "あ"
      sub: "サラセニアは食虫植物。｜甘さで虫をよせて、酸でまるごと溶かすのだ。"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.05
      kana: "エ'ッ、ト'ケタ/ムシノ'、エ'キイ？"
      text: "あ"
      sub: "えっ、とけた虫の、液ぃ！？"
      big: TRUE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "ずんだもん"
      sid: 3
      speed: 1.03
      kana: "ソ'オ、デ'モ、ソノ'/ト'ケタ/カニクト'/ミ'ツノ/アマサガ'、アノ'/ハオ'、オサトオノ'/モト'ニ/カエル'ノダ"
      text: "あ"
      sub: "そう。でも、そのとけた果肉と蜜のあまさが、｜あの葉を、お砂糖のもとに変えるのだ。"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 0.99
      kana: "フウン'、ナルホドネエ'"
      text: "あ"
      sub: "……ふーん。なるほどねえ。"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "つむぎ"
      sid: 8
      speed: 1.05
      kana: "キメタ'、ムシノ'/コト'ワ/ミ'ナカッタ/コト'ニ/シテ'、ソノ'/ハッパ'、アアシガ'/オサトオニ'/シテ'/モラッテ'/ク'モンネ"
      text: "あ"
      sub: "きめた。虫のことは見なかったことにして、｜その葉っぱ、あーしがお砂糖にしてもらってくもんね！"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
    {
      speaker: "ずんだもん"
      sid: 3
      speed: 1.03
      kana: "ショクチュウショク'ブツノ/ホ'オガ、イ'マニモ/ニゲダシタソ'オナ/カオ'/ナノダ'"
      text: "あ"
      sub: "……食虫植物のほうが、｜今にも逃げ出したそうな顔なのだ。"
      big: FALSE
      scene: "bog"
      item: "leaf"
    }
  ]
}

# buildScene の引数は、timeline.json のパスと、生成物を書き出す先と、それが最後に置かれる場所なのだ～🌱
videoProjectOf(name; script; (timelinePath; outDir; sceneDir) -> skitModule.build(
  {
    characters: CHARACTERS
    fonts: ["ZenMaruGothic-Black.ttf", "ZenMaruGothic-Bold.ttf"]
    emojis: ["seedling.svg"]

    # テンプレートが読む素材なのだ～🌱
    # TEX はテクスチャの相対パスの基準で、resourceDir は外部取得リソースの置き場所なのだ～🌱
    assetsOf: (TEX; resourceDir) -> {
    plant: TEX RESOLVE "textures/block/magic_plant/sarracenia_age3.png"
    leaf: TEX RESOLVE "textures/item/sarracenia_leaf.png"
    logo: TEX RESOLVE "icon.png"
    bg: TEX RESOLVE "textures/block/haimeviska_log.png"
    # seedling はパスではなく「生の SVG 文字列」なのだ～🌱
    # テンプレートが innerHTML に直接差し込むのだ～🌱
    seedling: READ(resourceDir RESOLVE "emoji/seedling.svg")::replace(/^\s+|\s+$/g; "")
    }

    poseDefault: POSE_DEFAULT
    poses: POSES

    # この寸劇のシーンとアイテムの不透明度なのだ～🌱
    # 沼地の背景は、泥沼のクロスフェードの下敷きだから、swampOp はずっと 1 なのだ～🌱
    framePartOf: (t; timeline; ops) -> (
      bogScenes := [timeline.scenes() >> FILTER[s => s.scene == "bog"]]
      {
        bogOp: $#bogScenes > 0 ? ops.fadeIn(t; bogScenes.0.start; timeline.sceneFade) : 0
        swampOp: 1
        plantOp: ops.itemOp(t; "plant")
        leafOp: ops.itemOp(t; "leaf")
      }
    )
  }
  timelinePath; outDir; sceneDir
))

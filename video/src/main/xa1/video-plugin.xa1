# =============================================================================
# video-plugin.xa1 — 動画プロジェクトに要るタスクを並べて渡すのだ～🌱（xarpite / API5）
# -----------------------------------------------------------------------------
# サブプロジェクトの xa1 が、これを USE して、videoProjectOf へ自分の名前と台本とシーンを組む関数を渡すのだ～🌱
# 返ってくるのは、段ごとのタスクが依存の順に並んだ AthanorProject なのだ～🌱
#
# 段の中身そのものは src/main/xa1/ の各モジュールが持っていて、ここはそれをタスクへ包むだけなのだ～🌱
# 段と段の順序は、ここの dependsOn が 1 か所で持つのだ～🌱
# =============================================================================

API(5)

@USE("athanor")
@USE("frames-plugin")

common := USE("common")
scriptModule := USE("script")
audioModule := USE("audio")
timelineModule := USE("timeline")
sceneModule := USE("scene")
movieModule := USE("movie")
cleanModule := USE("clean")

{
  videoProjectOf: (name; script; buildScene) -> (
    # 各段へ渡す、この動画ぶんの情報なのだ～🌱
    # 各段のモジュールは、どの動画を相手にするかを持たず、これを引数で受け取るのだ～🌱
    video := {name: name}
    # 台本は動画ごとに違うから、script の段がここを通して受け取るのだ～🌱
    video.script = script
    # シーンを組む処理は動画ごとに違うから、scene の段がここを通して呼ぶのだ～🌱
    video.buildScene = buildScene
    project := AthanorProject::NEW()

    task := (name; dependsOn; action) -> AthanorTask::NEW()::ALSO ( task =>
      task.name = name
      task.dependsOn = dependsOn
      task.action = action
    )

    project.tasks.generateScript = task("script"; []; () -> scriptModule.generate(video))
    project.tasks.generateAudio = task("audio"; [project.tasks.generateScript]; () -> audioModule.generate(video))
    project.tasks.generateTimeline = task("timeline"; [project.tasks.generateAudio]; () -> timelineModule.generate(video))
    project.tasks.generateScene = task("scene"; [project.tasks.generateTimeline]; () -> sceneModule.generate(video))
    # frames の段は、athanor のプラグインが持つタスククラスだから、入出力のパラメータをここで代入するのだ～🌱
    project.tasks.generateFrames = GenerateFramesTask::NEW()::ALSO ( task =>
      task.name = "frames"
      task.dependsOn = [project.tasks.generateScene]
      task.label = "frames ($name)"
      task.framesJsonlPath = () -> sceneModule.framesJsonlPath(video)
      task.outputDir = common.buildBase RESOLVE name RESOLVE "frames"
    )
    project.tasks.generateMovie = task("movie"; [project.tasks.generateTimeline, project.tasks.generateFrames]; () -> movieModule.generate(video; project.tasks.generateFrames::pngPattern()))
    project.tasks.clean = task("clean"; []; () -> cleanModule.run(video))
    # 主要なものをビルドする入口なのだ～🌱 中身を持たず、動画を作る段へ依存するだけなのだ～🌱
    project.tasks.build = task("build"; [project.tasks.generateMovie]; NULL)

    project
  )
}

# 動画プロジェクトにシーンを組ませる段なのだ～🌱（xarpite / API5）
# プロジェクトは自己完結したパートだから、その入口の main.xa1 を、別の xarpite の呼び出しとして叩くのだ～🌱

API(5)
@USE("common")

timelineModule := USE("timeline")

dirOf := project -> "$(project.buildBase)/scene"

{
  dir: dirOf
  framesJsonlPath: project -> "$(dirOf(project))/frames.jsonl"
  generate: project -> (
    timelineModule.generate(project)
    generate("scene ($(project.name))"; dirOf(project); work -> (
      run("$base/../xarpite/xarpite", "-A", "5", "-q", "-e", "USE(\"$(project.base)/main\").buildScene()", timelineModule.jsonPath(project), work)
    ))
  )
}

# 動画プロジェクトの台本を JSON へ焼く段なのだ～🌱（xarpite / API5）
# 台本そのものは xa1 の側がコミットされていて、JSON はこの段で作り直すのだ～🌱

API(5)
@USE("common")

dirOf := project -> "$buildBase/script/$(project.name)"

{
  path: project -> "$(dirOf(project))/script.json"
  generate: project -> generate("script ($(project.name))"; dirOf(project); work -> (
    WRITE("$work/script.json"; USE("$(project.base)/script") >> JSON[indent: 1])
  ))
}

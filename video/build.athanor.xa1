/*
 * build.athanor.xa1 — video/ のビルドの定義なのだ～🌱（xarpite / API5）
 *
 * athanor の main が、叩く対象の指定から取ったプロジェクト名を projectOf へ渡すのだ～🌱
 * 返ってくるのは athanor のプロジェクトで、タスクはその直下から名前で呼べるのだ～🌱
 *
 * 呼び出しの例：
 *   ./athanorw 2026-04-12-sarracenia:build
 **/

API(5)

# LOCATION はこのファイル自身のパスだから、その親を取れば、呼び出し元の居場所に関わらず video/ が得られるのだ～🌱
videoBase := LOCATION RESOLVE ".."
INC::push << videoBase RESOLVE "src/main/xa1", videoBase RESOLVE "src/athanor-plugins/xa1"

@USE("athanor")

common := USE("common")

{
  /** 名前の合うプロジェクトが無ければ NULL を返して、呼び出し元がそれを伝えるのだ～🌱 */
  projectOf: name ->
    : name == "" ? :
      AthanorProject::NEW()::ALSO ( project =>
        project.tasks.check = AthanorTask::NEW()::ALSO ( task =>
          task.name = "check"
          task.action = () -> OUT << "CHECK SUCCESSFUL"
        )
      )
    : common.projectOf(name)
}

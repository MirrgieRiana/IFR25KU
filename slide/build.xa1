# ============================================================
#   スフィアクラフト紹介スライドのビルドメイン（xarpite / API5）なのだ～🌱
#   global をマウントし、プラグイン・ページを読み込んでから、build 関数にビルドをまかせるのだ～🌱
#   ビルド本体（素材の配置・HTML/CSS の生成・完了メッセージ）は global の build 関数の中なのだ～🌱
# ============================================================

# このスクリプトが従う API バージョンを宣言するのだ～🌱 ランタイムと食い違っていたらエラーになるのだ～🌱
API(5)

# global・プラグイン・ページを bare 名の USE で解決できるように、各ソースセットを INC に入れるのだ～🌱
INC::push << "src/main/xa1"
INC::push << "src/plugins/xa1"
INC::push << "src/pages/xa1"

# global をマウントして、共有のレジストリ（templates・pageGenerators・cssLines）と build 関数を取り出すのだ～🌱
@USE("global")

# プラグインとページを名前順に読み込むのだ～🌱 各プラグインは templates と cssLines へ、各ページは pageGenerators へ登録するのだ～🌱
FILE_NAMES("src/plugins/xa1") >> SORT | fileName => USE(fileName)
FILE_NAMES("src/pages/xa1") >> SORT | fileName => USE(fileName)

# ビルド本体をまるごと build 関数にまかせるのだ～🌱 出力先を渡すのだ～🌱
build("build/site")

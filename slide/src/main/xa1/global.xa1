# ============================================================
#   グローバルモジュール（xarpite / API5）なのだ～🌱
#   メインと各プラグイン・ページが @USE("global") でマウントして共有するベースなのだ～🌱
#   - templates:      テンプレート関数のレジストリなのだ～🌱 各プラグインが templates.名前 = 関数 で登録するのだ～🌱
#   - pageGenerators: 出力ページのレジストリなのだ～🌱 キーが出力ファイル名で、値がその中身を返す関数なのだ～🌱 各ページが登録するのだ～🌱
#   - cssLines:       CSSの行をためていく配列なのだ～🌱 各プラグインが自分のパーツのCSSを push するのだ～🌱
#   - htmlEscape:     テキスト用のHTMLエスケープなのだ～🌱 & < > だけ処理するのだ～🌱
#   - colors:         矢印や演算子などに使うアクセント色なのだ～🌱
#   - build:          ビルド本体なのだ～🌱 素材を配置して、各ページと組み上げた CSS を出力先へ書き出すのだ～🌱
#   同じロケーションのUSEは再利用されるので、これらは全プラグイン・ページで単一の共有インスタンスになるのだ～🌱
# ============================================================

# @USE("global") でこれらをまとめてマウントするのだ～🌱
# オブジェクト内変数宣言（:=）にすることで、build 関数からとなりのレジストリを名前で直接参照できるのだ～🌱
{
  templates := {}
  pageGenerators := {}
  cssLines := []
  htmlEscape := text -> text::replaceAll("&"; "&amp;")::replaceAll("<"; "&lt;")::replaceAll(">"; "&gt;")
  colors := {
    pink: "#ef6cb0"
    purple: "#8d72d8"
    aqua: "#3fc4c0"
  }
  # ビルド本体なのだ～🌱 素材を出力先に配置してから、各ページと組み上げた CSS を書き出すのだ～🌱
  # プラグイン・ページの読み込みは build.xa1 が済ませているので、ここでは共有のレジストリを使うだけなのだ～🌱
  build := dir -> (
    # 1ファイルを書き出して、その場で完了メッセージを OUT するヘルパーなのだ～🌱
    writeFile := path, content -> (
      WRITE[path] << content
      OUT << "書き出したのだ～🌱 : $path"
    )

    # 出力先を作り直して素材（png/svg）を配置するのだ～🌱 既存のゴミも一掃してから作り直すのだ～🌱
    # 素材はライセンス別サブディレクトリのまま持ち込むので、cp -r で構造ごとコピーするのだ～🌱
    EXEC("bash", "-c", %>
      rm -rf -- "$1" &&
      mkdir -p -- "$1" &&
      cp -r -- src/site/resources/. "$1"/
    <%, "bash", dir)

    # 各ページを書き出すのだ～🌱（キー＝出力ファイル名、値＝内容を返す関数なのだ～🌱）
    pageGenerators() | entry => writeFile["$dir/$(entry.0)"] << entry.1()

    # 各プラグインが push した CSS 行の間に空行を挟んで、最後に統合して書き出すのだ～🌱（末尾も改行1個で閉じるのだ～🌱）
    writeFile["$dir/style.css"] << cssLines() >> REDUCE[a, b -> a, "", b] >> LINESD
  )
}

# layout: スライド共通のレイアウトのベースなのだ～🌱 横並びフロー(flow)と縦積みユニット(unit)を、複数のスライドで使いまわすのだ～🌱
@USE("global")

# 横並びフローなのだ～🌱 材料→珠→アイテム のような並びを中央ぞろえで流すのだ～🌱
# modifierClass は " flow4" のような追加クラスなのだ～🌱（追加が無ければ "" を渡すのだ～🌱）
templates.flow = modifierClass, inner -> %><div class="flow<%= modifierClass %>"><%= inner %></div><%
# 縦積みユニットなのだ～🌱 画像＋ラベルを縦の中央ぞろえにひとまとめにするのだ～🌱
# modifierClass は " switch-item" のような追加クラスなのだ～🌱（追加が無ければ "" を渡すのだ～🌱）
templates.unit = modifierClass, inner -> %><div class="unit<%= modifierClass %>"><%= inner %></div><%

cssLines::push << %>
  /* ---- 横並びフロー（材料→珠→アイテム など）なのだ～🌱 ---- */
  .flow {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .flow4 {
    gap: 10px;
  }

  /* ---- 縦積みユニット（画像＋ラベル）を縦の中央ぞろえにまとめるのだ～🌱 ---- */
  .unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
<%

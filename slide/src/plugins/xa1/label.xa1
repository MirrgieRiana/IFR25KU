# label: 汎用ラベルと色ユーティリティなのだ～🌱
@USE("global")

# 汎用ラベル div なのだ～🌱
templates.label = className, text -> %><div class="<%= className %>"><%= text >> htmlEscape %></div><%

# ---- 文字（ラベル）と色ユーティリティのCSSなのだ～🌱 色ユーティリティは .label より後に置くのだ～🌱 ----
cssLines::push << %>
  .label {
    font-size: var(--min-font-size);
    font-weight: 900;
    color: var(--ink);
    text-align: center;
    white-space: nowrap;
  }
  .label-sub {
    font-size: var(--min-font-size);
    font-weight: 800;
    color: var(--ink-soft);
    text-align: center;
    white-space: nowrap;
  }

  /* 色ユーティリティなのだ～🌱 */
  .ink {
    color: var(--ink);
  }
  .ink-soft {
    color: var(--ink-soft);
  }
  .pink-dark {
    color: var(--pink-dark);
  }
  .purple-dark {
    color: var(--purple-dark);
  }
  .aqua-dark {
    color: var(--aqua-dark);
  }
  .gold-dark {
    color: var(--gold-dark);
  }
  .brick-dark {
    color: var(--brick-dark);
  }
  .green-dark {
    color: var(--green-dark);
  }
<%

+class ModRecipeProvider(registries: HolderLookup.Provider, val recipeOutput: RecipeOutput) : RecipeProvider(registries, recipeOutput) {
+    val items = registries.lookupOrThrow(Registries.ITEM)
+
+    override fun buildRecipes() = DataGenerationEvents.onGenerateRecipe.fire { it(this) }
+
+    fun generateBlockFamily(family: BlockFamily, features: FeatureFlagSet) = generateRecipes(family, features)
+
+    fun generateStonecutterRecipe(category: RecipeCategory, result: Item, ingredient: Item, count: Int) =
+        stonecutterResultFromBase(category, result, ingredient, count)
+}
+
+interface DataMapConsumer {
+    fun <T : Any> accept(registry: ResourceKey<Registry<T>>, type: Identifier, target: ResourceKey<T>, data: JsonElement)
+}
